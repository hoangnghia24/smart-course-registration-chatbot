# PostgreSQL development
POSTGRES_DB=smart-course-registration-chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=8090

# Serverpod secrets
SERVERPOD_PASSWORD_serviceSecret=CHANGE_ME_LONG_RANDOM_SECRET
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=CHANGE_ME_RANDOM_REFRESH_PEPPER
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=CHANGE_ME_RANDOM_KEY_AT_LEAST_64_BYTES
SERVERPOD_PASSWORD_emailSecretHashPepper=CHANGE_ME_RANDOM_EMAIL_PEPPER
SERVERPOD_PASSWORD_serverSideSessionKeyHashPepper=CHANGE_ME
SCHOOL_GOOGLE_DOMAIN=your-school.example.edu
SCHOOL_EMAIL_DOMAIN=your-school.example.edu
# Optional services
REDIS_PORT=8091
POSTGRES_TEST_PORT=9090
# Development-only school account seeds. Do not enable in production.
APP_ENV=development
ALLOW_DEV_SEED=true

SEED_ADMIN_EMAIL=
SEED_LECTURER_EMAIL=
SEED_STUDENT_EMAIL=

SEED_ADMIN_PASSWORD=
SEED_LECTURER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Optional development datasets.
# Imports three reviewed-but-incomplete K26 curriculum drafts.
SEED_K26_CURRICULA=true

# Creates seven additional RAG students and their sections. Keep disabled
# unless the database is an isolated development fixture.
SEED_RAG_STUDENTS=false
SEED_RAG_ALLOW_INCOMPLETE_DEMO=false
SEED_RAG_STUDENT_PASSWORD=

SEED_K26_CURRICULA=false

SEED_RAG_STUDENTS=true
SEED_RAG_ALLOW_INCOMPLETE_DEMO=true